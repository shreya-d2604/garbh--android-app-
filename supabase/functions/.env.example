# Edge Function secrets (local: `supabase functions serve --env-file supabase/functions/.env`).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
# Never commit a filled-in copy of this file.

# AI provider: mock (default, deterministic, no network) | gemini (not enabled in this phase)
AI_PROVIDER=mock
# Local failure simulation for the mock: ok (default) | fail_once | fail_always | invalid
AI_MOCK_BEHAVIOR=ok
# Only read when AI_PROVIDER=gemini. Leave empty: no real key is used anywhere in this phase.
GEMINI_API_KEY=
GEMINI_MODEL=

# Push provider: mock (default, never touches the network) | expo (real Expo Push API)
PUSH_PROVIDER=mock

# Push dispatch from Postgres (pg_net -> send-push) needs the service-role key in Vault, once per
# database (it is NOT stored in the repo and is lost on `supabase db reset`):
#   select vault.create_secret('<service_role key from `npx supabase status`>', 'push_service_key');
# Optional override of the function URL (default http://kong:8000/functions/v1/send-push):
#   select vault.create_secret('http://kong:8000/functions/v1/send-push', 'push_function_url');
